# Chave da API da OpenAI
OPENAI_API_KEY=sua_chave_aqui

# Dados da API oficial do WhatsApp (Meta for Developers)
META_ACCESS_TOKEN=seu_token_de_acesso_aqui
META_PHONE_NUMBER_ID=seu_phone_number_id_aqui
META_VERIFY_TOKEN=uma_senha_que_voce_mesmo_inventa

# String de conexão do Postgres (no Railway, use uma "variable reference"
# apontando pro serviço Postgres - veja o README.md)
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Opcional: seu número pessoal (formato 5522999999999, sem +) - o bot manda
# um WhatsApp pra esse número quando algo dá errado. Também é o único
# número que consegue usar o comando /liberar (ver abaixo). Se não
# configurar, o bot funciona normal, só não manda alerta nem tem comando
# admin.
ADMIN_WHATSAPP_NUMERO=5522999999999

# Opcional: quantas refeições grátis a pessoa pode registrar antes do bot
# pedir pra assinar. Se não configurar, o padrão é 4.
LIMITE_REFEICOES_TESTE=4

# Opcional: números que NUNCA são cobrados (uso pessoal/família testando).
# Separado por vírgula, sem espaço. Já vem com um padrão no código (seu
# número, Marina, Elisa) - só precisa mexer aqui se quiser mudar a lista.
TESTADORES_ISENTOS=5522999297732,5522998011508,5522998034693

# Opcional: link de checkout da assinatura (Cakto, Mercado Pago, etc). Se
# não configurar, o bot ainda avisa que o limite bateu, só que sem link.
CAKTO_CHECKOUT_URL=https://pay.cakto.com.br/364vrp5_1022449

# Opcional (só necessário quando o webhook /webhook/cakto estiver 100%
# confirmado - ver comentário no bot.js). Segredo compartilhado pra
# validar que a chamada realmente veio da Cakto.
CAKTO_WEBHOOK_SECRET=
