# Chave da API da OpenAI
OPENAI_API_KEY=sua_chave_aqui

# Dados da API oficial do WhatsApp (Meta for Developers)
META_ACCESS_TOKEN=seu_token_de_acesso_aqui
META_PHONE_NUMBER_ID=seu_phone_number_id_aqui
META_VERIFY_TOKEN=uma_senha_que_voce_mesmo_inventa

# String de conexão do Postgres (no Railway, use uma "variable reference"
# apontando pro serviço Postgres - veja o README.md)
DATABASE_URL=postgresql://usuario:senha@host:porta/nome_do_banco

# Opcional: seu número pessoal (formato 5522999999999, sem +) - o bot manda
# um WhatsApp pra esse número quando algo dá errado. Se não configurar, o
# bot funciona normal, só não manda alerta nenhum.
ADMIN_WHATSAPP_NUMERO=5522999999999
